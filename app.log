import joblib
import mysql.connector
from flask import Flask, request, render_template

app = Flask(__name__)

# Load your trained model (update the path accordingly)
model = joblib.load('C:/Users/Sushmitha/OneDrive/Desktop/Flask/fraud detection 1/model.pkl')

@app.route('/')
def index():
    return render_template('fraud_form.html')  # Form to get transaction data

@app.route('/predict', methods=['POST'])
def predict():
    try:
        # Get data from the form
        step = float(request.form['step'])
        transaction_type = request.form['type']  # Ensure this is handled properly
        amount = float(request.form['amount'])
        oldbalanceOrg = float(request.form['oldbalanceOrg'])
        newbalanceOrig = float(request.form['newbalanceOrig'])
        oldbalanceDest = float(request.form['oldbalanceDest'])
        newbalanceDest = float(request.form['newbalanceDest'])

        # Convert transaction_type to numeric (binary) representation
        transaction_type_numeric = 1 if transaction_type == "credit" else 0  # Adjust as per your categories

        # Prepare input data for the model
        input_data = [[step, transaction_type_numeric, amount, oldbalanceOrg, newbalanceOrig, oldbalanceDest, newbalanceDest]]

        # Make prediction
        prediction = model.predict(input_data)

        # Determine if the transaction is fraudulent
        result = "Fraudulent" if prediction[0] == 1 else "Not Fraudulent"

        # Connect to the database (ensure your credentials are correct)
        db = mysql.connector.connect(
            host="localhost",
            user="user name",(actuall user name)
            password="password",(actual password)
            database="fraud_detection_db"
        )
        cursor = db.cursor()

        # Insert data into the transactions table
        cursor.execute(""" 
            INSERT INTO transactions (step, type, amount, oldbalanceOrg, newbalanceOrig, oldbalanceDest, newbalanceDest)
            VALUES (%s, %s, %s, %s, %s, %s, %s)
        """, (step, transaction_type, amount, oldbalanceOrg, newbalanceOrig, oldbalanceDest, newbalanceDest))

        db.commit()
        cursor.close()
        db.close()

        return render_template('transaction_result.html', result=result)

    except Exception as e:
        return render_template('transaction_result.html', result=f"Error: {str(e)}")

if __name__ == '__main__':
    app.run(debug=True)
